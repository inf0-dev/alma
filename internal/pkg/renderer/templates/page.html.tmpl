<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Model.Schema.Title }}</title>
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="shortcut icon" href="/assets/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plaster&display=swap">
  <style>{{ .CSS }}</style>
</head>
<body>
  <header class="page-header">
    <div class="alma-logo" style="font-family:'Plaster',sans-serif" aria-label="alma"><span class="alma-a1">a</span><span class="alma-l">l</span><span class="alma-m">m</span><span class="alma-a2">a</span></div>
    <div class="header-row">
      <h1>{{ .Model.Schema.Title }}</h1>
      <div class="header-actions">
        <button type="button" class="header-btn" id="load-btn" aria-label="Load file">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>Load</span>
        </button>
        <button type="button" class="header-btn" id="print-btn" aria-label="Print / Save as PDF">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          <span>PDF</span>
        </button>
        <div class="export-dropdown" id="export-dropdown">
          <button type="button" class="header-btn" id="export-btn" aria-label="Export record">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Export</span>
            <svg class="export-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="export-menu" id="export-menu" style="display:none">
            <button type="button" class="export-option" data-format="yaml">.yaml</button>
            <button type="button" class="export-option" data-format="json">.json</button>
            <button type="button" class="export-option" data-format="md">.md</button>
          </div>
        </div>
        <input type="file" id="load-file-input" accept=".yaml,.yml,.json" style="display:none">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      </div>
    </div>
    <div class="meta">
      {{ if .Model.Schema.Issue }}<span><a href="{{ .Model.Schema.Issue }}" target="_blank" rel="noopener">View Issue ↗</a></span>{{ end }}
      {{ if .Model.Metadata.Date }}<span>{{ .Model.Metadata.Date }}</span>{{ end }}
      {{ if .Model.Metadata.Author }}<span>by {{ .Model.Metadata.Author }}</span>{{ end }}
    </div>
  </header>

  <details class="section" open>
    <summary class="section-heading">
      <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Requirements <span class="section-count">({{ len .Requirements }})</span></span>
    </summary>
    <div class="requirements">
      {{ range .Requirements -}}
      <button type="button" class="req{{ if .Checked }} active{{ end }}" data-id="{{ .ID }}" aria-pressed="{{ if .Checked }}true{{ else }}false{{ end }}">
        {{ requirementDesc $.Model .ID }}
        <span class="req-type">{{ if .IsHard }}hard{{ else }}soft{{ end }}</span>
      </button>
      {{ end }}
    </div>
  </details>

  <details class="section" open>
    <summary class="section-heading">
      <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Items <span class="section-count">({{ len .Items }})</span></span>
    </summary>
    <div class="items">
      {{ range .Items -}}
      {{ $item := schemaItem $.Model .ID -}}
      <div class="item{{ if eq (string .Kind) "text" }} item-text{{ end }}">
        <label class="item-label" for="input-{{ $item.ID }}">{{ $item.Description }}</label>
        {{ if $item.Note }}<div class="note">{{ $item.Note }}</div>{{ end }}
        {{ if eq (string .Kind) "choice" -}}
        <div class="choices" id="input-{{ $item.ID }}">
          {{ range $item.ChoiceOptions -}}
          <button type="button" class="choice{{ if eq (derefOr $.Items $item.ID) .ID }} selected{{ end }}" data-item="{{ $item.ID }}" data-answer="{{ .ID }}" aria-pressed="{{ if eq (derefOr $.Items $item.ID) .ID }}true{{ else }}false{{ end }}">{{ .Description }}</button>
          {{ end }}
        </div>
        {{ else if eq (string .Kind) "number" -}}
        <input type="number" id="input-{{ $item.ID }}" class="item-input" data-item="{{ $item.ID }}"
          {{ if $item.NumberConfig }}{{ if $item.NumberConfig.Min }}min="{{ derefInt $item.NumberConfig.Min }}"{{ end }} {{ if $item.NumberConfig.Max }}max="{{ derefInt $item.NumberConfig.Max }}"{{ end }}{{ end }}
          {{ if .Value }}value="{{ .Value }}"{{ end }}
          {{ if .Unit }}placeholder="{{ .Unit }}"{{ end }}>
        {{ else -}}
        <textarea id="input-{{ $item.ID }}" class="item-input" data-item="{{ $item.ID }}" placeholder="">{{ if .Value }}{{ .Value }}{{ end }}</textarea>
        {{ end }}
      </div>
      {{ end }}
    </div>
  </details>

  <details class="section" open>
    <summary class="section-heading">
      <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Design Options <span class="section-count">({{ len .Options }})</span></span>
    </summary>
    <div class="options-split">
      <div class="options-list">
        {{ range .Options -}}
        {{ $opt := schemaOption $.Model .ID -}}
        <button type="button" class="option-list-item {{ .Status }}{{ if eq (index $.Options 0).ID .ID }} active{{ end }}" data-option-id="{{ .ID }}" {{ if eq (index $.Options 0).ID .ID }}aria-current="true"{{ end }}>
          <div class="option-list-header">
            <span class="option-title">{{ $opt.Title }}</span>
            <span class="option-status {{ .Status }}">{{ .Status }}</span>
          </div>
          <div class="req-grid" data-option="{{ .ID }}">
            <div class="req-grid-cells">
              {{ range reqGridCells $.Model .ID -}}
              <div class="req-cell {{ .Status }}" title="{{ .Desc }} ({{ .Type }}) — {{ .Status }}" data-req="{{ .ID }}" role="img" aria-label="{{ .Desc }}: {{ .Status }}"></div>
              {{ end }}
            </div>
            <span class="req-grid-label">{{ .Meets.Hard.Met }}/{{ .Meets.Hard.Of }} hard · {{ .Meets.Soft.Met }}/{{ .Meets.Soft.Of }} soft</span>
          </div>
        </button>
        {{ end }}
      </div>
      <div class="option-detail">
        {{ range .Options -}}
        {{ $opt := schemaOption $.Model .ID -}}
        <div id="option-{{ .ID }}" class="option-detail-panel {{ .Status }}{{ if eq (index $.Options 0).ID .ID }} active{{ end }}">
          <div class="option-detail-header">
            <span class="option-title">{{ $opt.Title }}</span>
            <span class="option-status {{ .Status }}">{{ .Status }}</span>
          </div>
          {{ if $opt.Description }}<div class="option-desc">{{ $opt.Description }}</div>{{ end }}

          <div class="failed-reqs" {{ if not .FailedRequirements }}style="display:none"{{ end }}>
            {{ if .FailedRequirements }}Failed: {{ joinFailedReqs $.Model .FailedRequirements }}{{ end }}
          </div>

          <ul class="blocks-list" {{ if not .FiredBlocks }}style="display:none"{{ end }}>
            {{ range .FiredBlocks }}<li class="block-reason">{{ . }}</li>{{ end }}
          </ul>

          {{ if or $opt.Pros $opt.Cons -}}
          <div class="pros-cons">
            {{ if $opt.Pros -}}
            <div class="pros">
              <div class="pros-cons-label">Pros</div>
              <ul>{{ range $opt.Pros }}<li>{{ . }}</li>{{ end }}</ul>
            </div>
            {{ end }}
            {{ if $opt.Cons -}}
            <div class="cons">
              <div class="pros-cons-label">Cons</div>
              <ul>{{ range $opt.Cons }}<li>{{ . }}</li>{{ end }}</ul>
            </div>
            {{ end }}
          </div>
          {{ end }}

          <ul class="effects-list" {{ if not .Effects }}style="display:none"{{ end }}>
            {{ range .Effects -}}
            <li>{{ if .Category }}<span class="effect-category">{{ .Category }}</span>{{ end }}{{ .Text }} <span style="color:var(--text-tertiary)">({{ .Kind }})</span></li>
            {{ end }}
          </ul>

          <div class="pick-area" data-option="{{ .ID }}" style="display:none">
            <button type="button" class="pick-btn">Pick this option</button>
            <div class="pick-form" style="display:none">
              <label class="pick-label" for="present-{{ .ID }}">Present</label>
              <input type="text" class="pick-present" id="present-{{ .ID }}" value="{{ if $.Present }}{{ joinStrings $.Present ", " }}{{ end }}" placeholder="Who was present for this decision?">
              <label class="pick-label" for="rationale-{{ .ID }}">Rationale (optional)</label>
              <textarea class="pick-rationale" id="rationale-{{ .ID }}" placeholder="Why this option?"></textarea>
              <div class="pick-actions">
                <button type="button" class="pick-confirm">Confirm</button>
                <button type="button" class="pick-cancel">Cancel</button>
              </div>
            </div>
          </div>
        </div>
        {{ end }}
      </div>
    </div>
  </details>

  <details class="section" id="decision-section" open aria-live="polite">
    <summary class="section-heading">
      <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Decision</span>
    </summary>
    <div id="decision-empty" class="decision-empty">
      No decision made yet. Align on an option from Design Options above.
    </div>
    <div id="decision-made" class="decision-made" style="display:none">
      <div class="decision-header">
        <div class="decision-option">
          <span class="decision-label">Picked</span>
          <span class="decision-title" id="decision-title"></span>
        </div>
        <button type="button" class="decision-undo" id="decision-undo">Undo</button>
      </div>
      <div class="decision-meta" id="decision-meta" style="display:none"></div>
      <div class="decision-rationale" id="decision-rationale" style="display:none"></div>
    </div>
  </details>

  <details class="section section-history" id="history-section" style="display:none">
    <summary class="section-heading">
      <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">History <span class="section-count" id="history-count"></span></span>
    </summary>
    <div class="history-list" id="history-list"></div>
  </details>

  <div class="modal-overlay" id="confirm-modal" style="display:none">
    <div class="modal-card">
      <div class="modal-title" id="confirm-modal-title"></div>
      <div class="modal-body" id="confirm-modal-body"></div>
      <div class="modal-actions">
        <button type="button" class="modal-btn modal-btn-cancel" id="confirm-modal-cancel">Cancel</button>
        <button type="button" class="modal-btn modal-btn-confirm" id="confirm-modal-confirm">Continue</button>
      </div>
    </div>
  </div>

  <footer class="page-footer">
    Built with <a class="alma-link" href="https://github.com/inf0-dev/alma" target="_blank" rel="noopener">alma</a> by <a href="https://github.com/inf0-dev" target="_blank" rel="noopener">inf0-dev</a>
  </footer>

  <script id="data-requirements" type="application/json">{{ .RequirementsJSON }}</script>
  <script id="data-items" type="application/json">{{ .ItemsJSON }}</script>
  <script id="data-schema" type="application/json">{{ .SchemaJSON }}</script>
  <script id="data-final" type="application/json">{{ .FinalJSON }}</script>
  <script id="data-history" type="application/json">{{ .HistoryJSON }}</script>
  <script>{{ .JS }}</script>
</body>
</html>
