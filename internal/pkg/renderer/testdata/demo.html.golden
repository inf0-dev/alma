<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cache Strategy Decision</title>
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="shortcut icon" href="/assets/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plaster&display=swap">
  <style>:root{--alma-cyan:#009aca;--alma-green:#00da3f;--alma-orange:#ff9c00;--alma-pink:#ff007b;--bg:#fafafa;--surface:#ffffff;--surface-hover:#f5f5f5;--border:#e8e8e8;--border-strong:#d4d4d4;--text:#1a1a1a;--text-secondary:#555555;--text-tertiary:#6b6b6b;--accent:var(--alma-cyan);--accent-soft:#e6f6fc;--accent-active-bg:#d0eef8;--accent-active-fg:#005f7f;--success:#00a832;--success-bg:#edfcf0;--success-border:#a0f0b0;--blocked:var(--alma-orange);--blocked-bg:#fff7eb;--blocked-border:#ffe0a0;--danger:var(--alma-pink);--danger-bg:#fff0f6;--danger-border:#ffc0da;--grid-empty:#e0e0e0;--grid-met:var(--alma-green);--grid-partial:#80ed9f;--shadow-sm:0 1px 2px rgba(0, 0, 0, 0.04);--shadow-md:0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);--shadow-lg:0 4px 16px rgba(0, 0, 0, 0.08), 0 2px 4px rgba(0, 0, 0, 0.04);--radius:10px;--radius-sm:6px;--font:"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;--mono:"SF Mono", "Fira Code", "Fira Mono", Menlo, monospace}[data-theme=dark]{--bg:#0f0f0f;--surface:#1a1a1a;--surface-hover:#222222;--border:#2a2a2a;--border-strong:#3a3a3a;--text:#e5e5e5;--text-secondary:#a0a0a0;--text-tertiary:#8a8a8a;--accent:#33b5e0;--accent-soft:#0d2a38;--accent-active-bg:#0f3548;--accent-active-fg:#7dd4f0;--success:#2ee85a;--success-bg:#0a2412;--success-border:#115a28;--blocked:#ffb333;--blocked-bg:#2a1e08;--blocked-border:#6b4a0a;--danger:#ff3d91;--danger-bg:#2a0c1a;--danger-border:#7f1040;--grid-empty:#333333;--grid-met:#2ee85a;--grid-partial:#60f08a;--shadow-sm:0 1px 2px rgba(0, 0, 0, 0.2);--shadow-md:0 2px 8px rgba(0, 0, 0, 0.3), 0 1px 2px rgba(0, 0, 0, 0.2);--shadow-lg:0 4px 16px rgba(0, 0, 0, 0.4), 0 2px 4px rgba(0, 0, 0, 0.2)}html{font-size:105%}*{box-sizing:border-box;margin:0;padding:0}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:1rem;line-height:1.6;max-width:1400px;margin:0 auto;padding:3rem 2rem;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.alma-logo{font-size:1.5rem;font-weight:800;letter-spacing:-.02em;margin-bottom:.75rem;user-select:none}.alma-logo>span{display:inline-block;transition:transform .5s cubic-bezier(.34,1.56,.64,1)}.alma-logo>span:hover{transform:scale(1.1)}.alma-a1{color:#009aca}.alma-l{color:#00da3f}.alma-m{color:#ff9c00}.alma-a2{color:#ff007b}.page-header{margin-bottom:2.5rem;padding-bottom:2rem;border-bottom:1px solid var(--border)}.page-header h1{font-size:1.75rem;font-weight:700;letter-spacing:-.025em;margin-bottom:.5rem}.meta{display:flex;flex-wrap:wrap;gap:.375rem 1.25rem;font-size:.9rem;color:var(--text-tertiary)}.meta a{color:var(--accent);text-decoration:none;font-weight:500}.meta a:hover{text-decoration:underline}.section{margin-bottom:1.25rem;border-left:3px solid var(--border);padding-left:1rem}.section:nth-of-type(1){border-left-color:var(--alma-cyan)}.section:nth-of-type(2){border-left-color:var(--alma-green)}.section:nth-of-type(3){border-left-color:var(--alma-orange)}.section:nth-of-type(4){border-left-color:var(--alma-pink)}.section-heading{display:flex;align-items:center;gap:.5rem;cursor:pointer;user-select:none;list-style:none;margin-bottom:1rem}.section-heading::-webkit-details-marker{display:none}.section-heading .chevron{width:16px;height:16px;color:var(--text-tertiary);transition:transform .2s ease;flex-shrink:0}details[open]>.section-heading .chevron{transform:rotate(90deg)}.section-title{font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary)}.section-count{font-weight:400;opacity:.7}.requirements-split{display:flex;flex-wrap:wrap;gap:1.25rem}.requirements-group{flex:auto;min-width:200px}.requirements-group-label{display:block;font-size:.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-tertiary);margin-bottom:.5rem}.requirements{display:flex;flex-wrap:wrap;gap:.5rem}.req{display:inline-flex;align-items:center;gap:.5rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.5rem .875rem;font-size:.9rem;font-weight:500;cursor:pointer;user-select:none;transition:all .15s ease;box-shadow:var(--shadow-sm);color:var(--text-secondary);font-family:var(--font)}.req:hover{border-color:var(--border-strong);box-shadow:var(--shadow-md);background:var(--surface-hover)}.req.active{background:var(--accent-active-bg);color:var(--accent-active-fg);border-color:var(--accent)}.req.active:hover{background:var(--accent-active-bg);color:var(--accent-active-fg);border-color:var(--accent);box-shadow:var(--shadow-md)}.items{display:flex;flex-wrap:wrap;gap:.75rem}.item{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1rem 1.25rem;box-shadow:var(--shadow-sm);flex:auto;min-width:240px}.item.item-text{flex-basis:50%;min-width:300px}.item-label{display:block;font-size:.95rem;font-weight:600;color:var(--text);margin-bottom:.125rem}.item .note{font-size:.85rem;color:var(--text-tertiary);margin-bottom:.625rem}.item-label+.choices,.item-label+input,.item-label+textarea{margin-top:.625rem}.item .note+.choices,.item .note+input,.item .note+textarea{margin-top:0}.choices{display:flex;flex-wrap:wrap;gap:.375rem}.choice{padding:.4rem .8rem;border:1px solid var(--border);border-radius:var(--radius-sm);cursor:pointer;background:var(--surface);color:var(--text-secondary);font-size:.9rem;font-weight:500;font-family:var(--font);transition:all .15s ease}.choice:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}.choice.selected{background:var(--accent);color:#fff;border-color:var(--accent)}input[type=number],input[type=text],textarea{width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:.9rem;font-family:var(--font);color:var(--text);background:var(--surface);transition:border-color .15s ease,box-shadow .15s ease}input:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}textarea{resize:vertical;min-height:56px}input::placeholder,textarea::placeholder{color:var(--text-tertiary)}.options-split{display:flex;gap:1rem;min-height:300px}.options-list{flex:0 0 280px;display:flex;flex-direction:column;gap:.375rem;overflow-y:auto;max-height:70vh}.option-list-item{display:block;width:100%;text-align:left;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.75rem 1rem;cursor:pointer;font-family:var(--font);color:var(--text);transition:all .15s ease}.option-list-item:hover{border-color:var(--border-strong);background:var(--surface-hover)}.option-list-item.active{border-color:var(--accent);background:var(--accent-soft)}.option-list-item.active .req-grid-label{color:var(--text-secondary)}.option-list-item.blocked{opacity:.7}.option-list-item.eliminated{opacity:.5}.option-list-item.active.blocked,.option-list-item.active.eliminated{opacity:1}.option-list-header{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.375rem}.option-list-item .option-title{font-size:.9rem}.option-list-item .req-grid{margin-bottom:0}.option-detail{flex:1;min-width:0}.option-detail-panel{display:none;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;box-shadow:var(--shadow-sm)}.option-detail-panel.active{display:block}.option-detail-panel.blocked{opacity:.7}.option-detail-panel.eliminated{opacity:.5}.option-detail-header{display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem;margin-bottom:.375rem}.option-title{font-weight:700;font-size:1.05rem;letter-spacing:-.01em}.option-status{font-size:.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;padding:.1875rem .5rem;border-radius:4px;flex-shrink:0}.option-status.possible{background:var(--success-bg);color:var(--success);border:1px solid var(--success-border)}.option-status.blocked{background:var(--blocked-bg);color:var(--blocked);border:1px solid var(--blocked-border)}.option-status.eliminated{background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger-border)}.option-status.picked{background:var(--accent-soft);color:var(--accent);border:1px solid var(--accent)}.option-list-item.picked{border-color:var(--accent);background:var(--accent-soft)}.option-detail-panel.picked{border-color:var(--accent)}.option-desc{font-size:.9rem;color:var(--text-secondary);line-height:1.6;margin-bottom:1rem}.option-desc code{font-family:var(--mono);font-size:.85em;background:var(--surface-hover);border:1px solid var(--border);border-radius:4px;padding:.15em .4em}.req-grid{display:flex;align-items:center;gap:.625rem;margin-bottom:.75rem}.req-grid-cells{display:grid;grid-template-columns:repeat(6,14px);gap:3px}.req-cell{width:14px;height:14px;border-radius:3px;background:var(--grid-empty);transition:background .2s ease;cursor:default;position:relative}.req-cell.met{background:var(--grid-met)}.req-cell.partial{background:var(--grid-partial)}.req-cell.failed{background:var(--danger)}.req-grid-label{font-size:.75rem;color:var(--text-tertiary);font-weight:500}.failed-reqs,.blocks-list{font-size:.9rem;color:var(--danger);font-weight:500;margin-top:.5rem;padding:.5rem .625rem;background:var(--danger-bg);border-radius:var(--radius-sm);list-style:none;line-height:1.4}.blocks-list li+li{margin-top:.25rem}.effects-list{list-style:none;font-size:.9rem;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border)}.effects-list li{padding:.25rem 0;line-height:1.4}.effect-category{font-family:var(--mono);font-size:.75rem;font-weight:600;color:var(--accent);background:var(--accent-soft);padding:.125rem .375rem;border-radius:3px;margin-right:.25rem}.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border)}.pros-cons-label{font-size:.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem}.pros .pros-cons-label{color:var(--success)}.cons .pros-cons-label{color:var(--danger)}.pros ul,.cons ul{list-style:none;font-size:.9rem}.pros li::before{content:"+";color:var(--success);font-weight:700;margin-right:.375rem}.cons li::before{content:"−";color:var(--danger);font-weight:700;margin-right:.375rem}.pros li,.cons li{padding:.125rem 0;color:var(--text-secondary)}.header-row{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}.header-actions{display:flex;align-items:center;gap:.5rem}.header-btn{display:flex;align-items:center;gap:.35rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.375rem .65rem;cursor:pointer;color:var(--text-secondary);font-size:.8rem;font-family:inherit;transition:border-color .15s,box-shadow .15s,color .15s}.header-btn:hover{border-color:var(--border-strong);box-shadow:var(--shadow-md);color:var(--text)}.header-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.header-btn svg{width:16px;height:16px;flex-shrink:0}.export-dropdown{position:relative}.export-chevron{width:12px;height:12px;margin-left:-.1rem;opacity:.6}.export-menu{position:absolute;top:100%;right:0;margin-top:.25rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);box-shadow:var(--shadow-lg);min-width:100px;z-index:100;overflow:hidden}.export-option{display:block;width:100%;text-align:left;padding:.45rem .75rem;border:none;background:0 0;color:var(--text);font-size:.8rem;font-family:var(--mono);cursor:pointer;transition:background .1s,color .1s}.export-option:hover{background:var(--accent-soft);color:var(--accent)}.export-option+.export-option{border-top:1px solid var(--border)}.theme-toggle{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.375rem;cursor:pointer;color:var(--text-secondary);display:flex;align-items:center;justify-content:center;width:36px;height:36px;flex-shrink:0;transition:all .15s ease;box-shadow:var(--shadow-sm)}.theme-toggle:hover{border-color:var(--border-strong);box-shadow:var(--shadow-md);color:var(--text)}.theme-toggle svg{width:18px;height:18px}.theme-toggle .icon-moon{display:none}[data-theme=dark] .theme-toggle .icon-sun{display:none}[data-theme=dark] .theme-toggle .icon-moon{display:block}.toast{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%)translateY(1rem);background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger-border);border-radius:var(--radius-sm);padding:.5rem 1rem;font-size:.85rem;opacity:0;transition:opacity .3s,transform .3s;z-index:1000}.toast.visible{opacity:1;transform:translateX(-50%)translateY(0)}.decision-empty{font-size:.9rem;color:var(--text-tertiary);padding:1.5rem;text-align:center;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius)}.decision-made{background:var(--surface);border:1px solid var(--accent);border-radius:var(--radius);padding:1.25rem 1.5rem}.decision-header{display:flex;align-items:center;justify-content:space-between;gap:1rem}.decision-option{display:flex;flex-direction:column;gap:.125rem}.decision-label{font-size:.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--accent)}.decision-title{font-weight:700;font-size:1.05rem}.decision-meta{font-size:.85rem;color:var(--text-tertiary);margin-top:.5rem}.decision-rationale{font-size:.9rem;color:var(--text-secondary);font-style:italic;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border);line-height:1.5}.decision-undo{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.375rem .75rem;cursor:pointer;color:var(--text-secondary);font-size:.8rem;font-family:inherit;transition:border-color .15s,color .15s;flex-shrink:0}.decision-undo:hover{border-color:var(--danger-border);color:var(--danger)}.pick-area{margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--border)}.pick-btn{background:var(--accent-soft);color:var(--accent);border:1px solid var(--accent);border-radius:var(--radius-sm);padding:.5rem 1rem;cursor:pointer;font-size:.85rem;font-weight:600;font-family:inherit;transition:background .15s,box-shadow .15s}.pick-btn:hover{background:var(--accent);color:#fff;box-shadow:var(--shadow-md)}.pick-form{display:flex;flex-direction:column;gap:.5rem}.pick-label{font-size:.85rem;font-weight:500;color:var(--text-secondary)}.pick-actions{display:flex;gap:.5rem}.pick-confirm{background:var(--accent);color:#fff;border:none;border-radius:var(--radius-sm);padding:.4rem 1rem;cursor:pointer;font-size:.85rem;font-weight:600;font-family:inherit;transition:opacity .15s}.pick-confirm:hover{opacity:.9}.pick-cancel{background:var(--surface);color:var(--text-secondary);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.4rem 1rem;cursor:pointer;font-size:.85rem;font-family:inherit;transition:border-color .15s,color .15s}.pick-cancel:hover{border-color:var(--border-strong);color:var(--text)}.section-history{border-left-color:var(--border-strong)!important}.history-list{display:flex;flex-direction:column;gap:1rem}.history-entry{border-left:2px solid var(--border);padding-left:1rem}.history-entry-title{font-weight:600;color:var(--text)}.history-entry-meta{font-size:.8rem;color:var(--text-tertiary);margin-top:.125rem}.history-entry-rationale{font-size:.8rem;color:var(--text-secondary);font-style:italic;margin-top:.25rem}.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;z-index:2000}[data-theme=dark] .modal-overlay{background:rgba(0,0,0,.6)}.modal-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-lg);padding:1.5rem;max-width:420px;width:90%}.modal-title{font-weight:700;font-size:1rem;margin-bottom:.5rem}.modal-body{font-size:.9rem;color:var(--text-secondary);line-height:1.5;margin-bottom:1.25rem}.modal-actions{display:flex;justify-content:flex-end;gap:.5rem}.modal-btn{border-radius:var(--radius-sm);padding:.4rem 1rem;cursor:pointer;font-size:.85rem;font-weight:600;font-family:inherit;transition:opacity .15s,border-color .15s}.modal-btn-cancel{background:var(--surface);color:var(--text-secondary);border:1px solid var(--border)}.modal-btn-cancel:hover{border-color:var(--border-strong);color:var(--text)}.modal-btn-confirm{background:var(--danger);color:#fff;border:none}.modal-btn-confirm:hover{opacity:.9}.page-footer{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--border);text-align:center;font-size:.85rem;color:var(--text-tertiary)}.page-footer a{color:var(--text-secondary);text-decoration:none;font-weight:500}.page-footer a:hover{color:var(--accent);text-decoration:underline}.page-footer .alma-link:hover{background:linear-gradient( 90deg,var(--alma-cyan),var(--alma-green),var(--alma-orange),var(--alma-pink),var(--alma-cyan) );background-size:200% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;text-decoration:none;animation:alma-gradient 2s linear infinite}@keyframes alma-gradient{to{background-position:-200% 0}}@media(max-width:720px){body{padding:1.5rem 1rem}.options-split{flex-direction:column}.options-list{flex:none;max-height:none}.pros-cons{grid-template-columns:1fr}}@media print{body{padding:0;font-size:11pt;max-width:none;color:#000;background:#fff}.header-actions,.theme-toggle,.pick-area,.modal-overlay,.toast,.page-footer,.export-dropdown,#print-btn{display:none!important}details{display:block!important}details>summary{list-style:none;pointer-events:none}details>summary .chevron{transform:rotate(90deg)}.section{border-left:2px solid #999;page-break-inside:avoid}.options-split{flex-direction:column}.options-list{display:none}.option-detail-panel{display:block!important;opacity:1!important;border:1px solid #ccc;margin-bottom:.75rem;box-shadow:none;page-break-inside:avoid}.decision-made{border-color:#999;box-shadow:none}.decision-undo{display:none}.option-status{border:1px solid #999;background:0 0}a{color:#000;text-decoration:underline}.item,.req,.pros-cons{page-break-inside:avoid}}</style>
</head>
<body>
  <header class="page-header">
    <div class="alma-logo" style="font-family:'Plaster',sans-serif" aria-label="alma"><span class="alma-a1">a</span><span class="alma-l">l</span><span class="alma-m">m</span><span class="alma-a2">a</span></div>
    <div class="header-row">
      <h1>Cache Strategy Decision</h1>
      <div class="header-actions">
        <button type="button" class="header-btn" id="load-btn" aria-label="Load file">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>Load</span>
        </button>
        <button type="button" class="header-btn" id="print-btn" aria-label="Print / Save as PDF">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          <span>PDF</span>
        </button>
        <div class="export-dropdown" id="export-dropdown">
          <button type="button" class="header-btn" id="export-btn" aria-label="Export record">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Export</span>
            <svg class="export-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="export-menu" id="export-menu" style="display:none">
            <button type="button" class="export-option" data-format="yaml">.yaml</button>
            <button type="button" class="export-option" data-format="json">.json</button>
            <button type="button" class="export-option" data-format="md">.md</button>
          </div>
        </div>
        <input type="file" id="load-file-input" accept=".yaml,.yml,.json" style="display:none">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
